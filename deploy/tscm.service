[Unit]
Description=SWEEPERZERO TSCM Monitoring Service
After=network.target gpsd.service
Wants=gpsd.service

[Service]
Type=simple
User=tscm
Group=tscm
WorkingDirectory=/opt/tscm

# Environment
Environment="TSCM_CONFIG=/etc/tscm/config.yaml"
Environment="PYTHONUNBUFFERED=1"

# Run sweep command (customize as needed)
ExecStart=/usr/local/bin/tscm sweep --kind all --client production --site datacenter --room server_room

# Restart policy
Restart=on-failure
RestartSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tscm /var/log/tscm

# Capabilities (for raw sockets, USB device access)
# Add as needed based on hardware requirements
# AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tscm

[Install]
WantedBy=multi-user.target
